{
	"Name": "Mutastic",
	"Author": "Dan Shapiro",
	"Version": "1.0.0",
	"Icon": "icons/mutastic-mic",
	"Category": "Custom",
	"CodePathWin": "mutastic.exe",
	"OS": [
		{ "Platform": "windows", "MinimumVersion": "10" }
	],
	"Actions": [
		{
			"Name": "Mutastic Mute",
			"UUID": "com.danshapiro.mutastic.mute",
			"Tooltip": "Toggle mic mute everywhere; icon tracks the true mic state",
			"Icon": "icons/mutastic-mic",
			"DisableAutomaticStates": true,
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"States": [
				{ "Image": "icons/mutastic-mic", "Name": "Live", "ShowTitle": false },
				{ "Image": "icons/mutastic-mic-muted", "Name": "Muted", "ShowTitle": false }
			]
		},
		{
			"Name": "Mutastic Lights",
			"UUID": "com.danshapiro.mutastic.light",
			"Tooltip": "Toggle all NEEWER lights; icon tracks whether any light is on",
			"Icon": "icons/mutastic-light-on",
			"DisableAutomaticStates": true,
			"Controllers": ["Keypad"],
			"SupportedInMultiActions": false,
			"States": [
				{ "Image": "icons/mutastic-light-off", "Name": "Off", "ShowTitle": false },
				{ "Image": "icons/mutastic-light-on", "Name": "On", "ShowTitle": false }
			]
		}
	]
}
